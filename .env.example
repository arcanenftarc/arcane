# Public site URL used for canonical / Open Graph metadata.
# Never put secrets or API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SITE_URL=https://arcanenft.xyz

# X OAuth (server-only). Required for Continue with X on the whitelist section.
# Set the same names in the Cloudflare Worker environment.
# Callback URL: https://arcanenft.xyz/api/auth/x/callback
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# Google Sheet whitelist log (server-only). Share the sheet with the service account as Editor.
# Headers: username | task 01 | task 02 | task 03 | submitted wallet
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_TAB=Whitelist
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Later stages
# DATABASE_URL=
# MINT_CONTRACT_ADDRESS=
